generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum CurrentFeel {
  MOTIVATED
  UNMOTIVATED
  OVERWHELMED
  STRESSED
  ANXIOUS
  CONFIDENT
  TIRED
  DISCOURAGED
  AMBITIOUS
  LOST_UNCERTAIN
}

enum JobLevel {
  STUDENT
  INTERN
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD_MANAGER
  OWNER_FOUNDER
  EXECUTIVE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  preference         UserPreference?
  quotes             UserQuote[]
  passwordResetTokens PasswordResetToken[]
}

model Profession {
  id       String  @id @default(uuid())
  name     String  @unique
  category String
  isActive Boolean @default(true)

  preferences UserPreference[]

  @@index([category])
}

model UserPreference {
  id               String      @id @default(uuid())
  userId           String      @unique
  professionId     String
  customProfession String?     // used when profession is "Other"
  currentFeel      CurrentFeel
  jobLevel         JobLevel
  updatedAt        DateTime    @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Restrict)
}

model Quote {
  id         String   @id @default(uuid())
  externalId String?
  content    String
  author     String?  // null unless attribution is reliable
  tags       String[] @default([])
  source     String
  createdAt  DateTime @default(now())

  userQuotes UserQuote[]

  @@unique([source, externalId])
  @@index([source])
}

model UserQuote {
  id            String   @id @default(uuid())
  userId        String
  quoteId       String
  intervalStart DateTime // UTC, floor(ts/600)*600
  assignedAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([userId, intervalStart])
  @@index([userId, assignedAt(sort: Desc)])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}